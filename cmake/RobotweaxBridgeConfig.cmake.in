@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
set(_robotweax_bridge_features "@_bridge_features@")
if("protocol" IN_LIST _robotweax_bridge_features)
  find_dependency(Protobuf 3.21)
  find_dependency(OpenSSL 3.0 COMPONENTS Crypto)
  find_dependency(SQLite3 3.45)
endif()
if("worker" IN_LIST _robotweax_bridge_features OR "transport" IN_LIST _robotweax_bridge_features)
  find_dependency(Threads)
endif()
if("transport" IN_LIST _robotweax_bridge_features)
  find_dependency(RobotweaxSRT 0.3 CONFIG)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/RobotweaxBridgeTargets.cmake")
foreach(_robotweax_feature IN LISTS _robotweax_bridge_features)
  set(RobotweaxBridge_${_robotweax_feature}_FOUND TRUE)
endforeach()
if(TARGET RobotweaxBridge::protocol AND NOT TARGET RobotweaxBridge::management)
  add_library(RobotweaxBridge::management ALIAS RobotweaxBridge::protocol)
  set(RobotweaxBridge_management_FOUND TRUE)
endif()
check_required_components(RobotweaxBridge)
unset(_robotweax_feature)
unset(_robotweax_bridge_features)

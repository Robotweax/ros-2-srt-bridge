<?xml version="1.0" encoding="UTF-8"?>
<!-- Explicit M3 variant: avoid IP fragmentation of DDS discovery samples.
     Preserve UDPv4 + SHM, default buffers, and all application QoS/lease gates. -->
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <profiles>
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>m3_udp1200</transport_id>
        <type>UDPv4</type>
        <maxMessageSize>1200</maxMessageSize>
      </transport_descriptor>
      <transport_descriptor>
        <transport_id>m3_shm1200</transport_id>
        <type>SHM</type>
        <maxMessageSize>1200</maxMessageSize>
      </transport_descriptor>
    </transport_descriptors>
    <participant profile_name="m3_udp1200" is_default_profile="true">
      <rtps>
        <userTransports>
          <transport_id>m3_udp1200</transport_id>
          <transport_id>m3_shm1200</transport_id>
        </userTransports>
        <useBuiltinTransports>false</useBuiltinTransports>
      </rtps>
    </participant>
  </profiles>
</dds>
